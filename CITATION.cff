  type: article
  authors:
    - family-names: Gibson
      given-names: Landon
    - family-names: Zimmerman
      given-names: Frederick
  title: "Measuring the sensitivity of difference-in-difference estimates to the parallel trends assumption"
  journal: "Research Methods in Medicine & Health Sciences"
  year: 2021
  volume: 2
  issue: 4
  start: 148
  end: 156
  doi: 10.1177/26320843211061306
